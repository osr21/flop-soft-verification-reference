  "source": {
    "title": "FLOP Network Yellow Paper",
    "version": "0.5.0",
    "url": "https://github.com/flop-labs/yellowpaper/blob/main/yellowpaper.md",
    "note": "The public repository labels v0.5.0 as an initial draft; this profile is a small proposal for the open E.33 SOFT-tier item."
  },
  "requirements": [
    {"id": "R3.1", "citation": "§3.1", "text": "Settled sessions carry a required execution-integrity commitment."},
    {"id": "R3.3", "citation": "§3.1", "text": "Independent re-execution and collectible aggregate exposure must satisfy the effective-challenge deterrence condition."},
    {"id": "R3.5", "citation": "§3.1", "text": "Accepted evidence binds task, metered work, model, and output."},
    {"id": "R3.6", "citation": "§3.1", "text": "Each task is creditable at most once."},
    {"id": "R5.3d", "citation": "§5.3", "text": "Ephemeral evidence retention covers the challenge window."},
    {"id": "R12.1b", "citation": "§12.1", "text": "SOFT turns use a session key and co-signed monotonic receipts."},
    {"id": "R12.1a", "citation": "§12.1", "text": "Reserved escrow is paid optimistically; timeout and fraud are refund paths."},
    {"id": "R12.1d", "citation": "§12.1", "text": "Failed or early close uses an explicit refund and tariff split."},
    {"id": "R12.1f", "citation": "§12.1", "text": "Fraud disputes and response timeouts refund the agent and slash the miner."},
    {"id": "R13.0b", "citation": "§13.0", "text": "Temporary DA loss may extend a window once without payout or slash."},
    {"id": "R13.0c", "citation": "§13.0", "text": "Unrecoverable DA fails closed with escrow and challenger-bond refund."},
    {"id": "E.33", "citation": "Appendix E", "text": "The non-TEE SOFT tier needs an end-to-end profile."},
    {"id": "E.45", "citation": "Appendix E", "text": "The effective-challenge incentive model is conditional and illustrative."}
  ],
  "harnessed_bound_fields": ["session_id", "profile", "index", "task_hash", "model_hash", "payload_hash", "decode_policy_hash", "precision", "backend", "gpu_cell", "prompt_hash", "input_hash", "output_hash", "gn", "toploc_root", "activation_commitment", "da_reference", "nonce"],
